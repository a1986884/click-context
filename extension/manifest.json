{
  "manifest_version": 3,
  "name": "语境精读",
  "version": "0.8.0",
  "minimum_chrome_version": "130",
  "description": "为英语学习者设计的网页精读插件：点英文单词，结合当前原句看懂此处含义；支持划词翻译、网页双语阅读和本地生词收藏。按网站启用。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://dict.youdao.com/*",
    "https://lextide-context.aa1986884.workers.dev/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_title": "语境精读 · 为英语学习者设计的网页精读插件",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "options_ui": {
    "page": "engines.html",
    "open_in_tab": true
  },
  "short_name": "语境精读"
}
